{
  "name": "@wanadev/pennylane-mcp",
  "version": "0.2.0",
  "description": "MCP server for the Pennylane v2 API — auto-generated from the official OpenAPI spec.",
  "type": "module",
  "main": "build/server.js",
  "bin": {
    "pennylane-mcp": "build/server.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync:openapi": "tsx scripts/sync-openapi.ts",
    "generate": "tsx scripts/generate-tools.ts",
    "build": "tsc",
    "prepare": "npm run generate && npm run build",
    "prepublishOnly": "npm run build",
    "start": "node build/server.js",
    "dev": "tsx src/server.ts"
  },
  "files": [
    "build",
    "openapi",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pennylane",
    "accounting",
    "claude"
  ],
  "author": "Wanadev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wanadev/pennylane-mcp"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.7.0",
    "commander": "^12.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
